# Local environment template — copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored (.gitignore); .env.example is committed as documentation.
# Load into a shell with:  set -a && . .env && set +a

# --- Bencher Cloud (perf results) ---
# Personal API token from https://bencher.dev/console/user/tokens
# Only needed for authenticated/write access — the gMountie project is public,
# so read-only queries (report list, etc.) work without it.
BENCHER_API_TOKEN=

# Project slug under the gMountie org (NOT "gmountie" — that slug was taken).
BENCHER_PROJECT=gmountie-tfkojd8g

# Testbed the self-hosted release runner reports under.
BENCHER_TESTBED=gmountie-perf-pod
