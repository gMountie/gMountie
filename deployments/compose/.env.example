# Copy to `.env` (gitignored) and adjust. Compose interpolates these into
# docker-compose.yaml before starting the stack.
#
# NOTE: basic-auth credentials are NOT settable here — gMountie has no env-var
# override for the auth.users list. config.yaml ships the PUBLISHED demo
# credential (user "demo", password "demo", as an argon2id `password_hash`).
# CHANGE IT before exposing the server: run `gmountie genpass` and paste the
# hash into config.yaml (plaintext `password:` is rejected at startup).

# Container image tag to run.
GMOUNTIE_IMAGE_TAG=latest

# Host port published for the gRPC API. The ops/metrics endpoint binds
# loopback inside the container and is not published; use
# `docker compose exec server wget -qO- http://127.0.0.1:9090/healthz`.
GRPC_PORT=9449
