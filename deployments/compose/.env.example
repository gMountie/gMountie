# Copy to `.env` (gitignored) and adjust. Compose interpolates these into
# docker-compose.yaml before starting the stack.
#
# NOTE: basic-auth credentials are NOT settable here — gMountie has no env-var
# override for the auth.users list. Edit config.yaml (or mount your own) to
# change the demo admin/CHANGE_ME_BEFORE_DEPLOY credential.

# Container image tag to run.
GMOUNTIE_IMAGE_TAG=latest

# Host ports published for the gRPC API and the metrics/health endpoint.
GRPC_PORT=9449
METRICS_PORT=9090
