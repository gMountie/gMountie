# Copy to /etc/gmountie/<volume>.env (e.g. /etc/gmountie/shared.env) and edit.
# Used by gmountie-mount@<volume>.service.
#
# This file carries the mount password — install it root-only, never with a
# plain `cp` (which leaves it world-readable):
#
#   install -o root -g root -m 600 gmountie.env.example /etc/gmountie/shared.env
#
# Better: keep the password out of the env file entirely and use systemd
# LoadCredential= in a drop-in, reading it via $CREDENTIALS_DIRECTORY
# (see systemd.exec(5) "Credentials").
SERVER=admin@host.example:9449
MOUNTPOINT=/mnt/shared
GMOUNTIE_AUTH_PASSWORD=replace-me
